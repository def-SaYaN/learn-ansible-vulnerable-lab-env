# Example only. The real inventory/hosts.ini is generated by `terraform apply`
# with live public IPs. This shows the shape.
[domain_controllers]
dc01 ansible_host=<dc01_public_ip>

[domain_members]
srv01 ansible_host=<srv01_public_ip>
ws01  ansible_host=<ws01_public_ip>

[linux_pivot]
pivot ansible_host=<pivot_public_ip> ansible_connection=ssh ansible_user=ubuntu

[windows:children]
domain_controllers
domain_members

[lab:children]
windows
linux_pivot
